---
import Sidebar from '../components/Sidebar.astro';
import FloatingChat from '../components/FloatingChat';
import '../styles/global.css';

interface Props {
  title: string;
  showSidebar?: boolean;
}

const { title, showSidebar = true } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="HerBrain - Digital twins of women's brains. Explore brain transformations during pregnancy and menstruation.">
  <link rel="icon" type="image/png" href="/assets/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <title>{title} | HerBrain</title>
</head>
<body class="bg-herbrain-bg">
  {showSidebar && <Sidebar currentPath={currentPath} />}
  
  <main class:list={[
    showSidebar ? 'md:ml-72 p-4 md:p-6 md:mr-6 min-h-screen' : 'min-h-screen'
  ]}>
    <slot />
  </main>
  
  {/* Floating AI Neurobot Chat - Available on all pages with sidebar */}
  {/* Hide floating button on pregnancy page since it has inline Neurobot button */}
  {showSidebar && <FloatingChat client:only="react" hideFloatingButton={currentPath === '/pregnancy' || currentPath === '/pregnancy/'} />}
</body>
</html>
