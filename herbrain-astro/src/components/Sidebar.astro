---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems = [
  { href: '/pregnancy', text: 'Pregnancy', icon: '/assets/pregnancy_logo.png' },
  { href: '/menstruation', text: 'Menstruation', icon: '/assets/menstrual_logo.png' },
  { href: '/menopause', text: 'Menopause', icon: null, color: 'purple' },
];
---

<aside class="fixed top-0 left-0 bottom-0 w-72 p-6 bg-white border-r border-gray-200 flex flex-col">
  <!-- Logo -->
  <a href="/" class="block mb-2">
    <img 
      src="/assets/herbrain_logo.png" 
      alt="HerBrain" 
      class="w-52 h-auto cursor-pointer hover:opacity-90 transition-opacity"
    />
  </a>
  
  <!-- Subtitle -->
  <p class="font-sans text-sm text-herbrain-muted mt-4 mb-0 font-normal tracking-wide">
    Digital twins of women's brains
  </p>
  
  <hr class="my-6 border-gray-200 opacity-70" />
  
  <!-- Navigation -->
  <nav class="flex flex-col gap-2">
    {navItems.map((item) => {
      const isActive = currentPath === item.href;
      const activeClass = item.href === '/pregnancy' 
        ? 'active-pregnancy' 
        : item.href === '/menstruation'
        ? 'active-menstruation'
        : 'active-menopause';
      
      return (
        <a 
          href={item.href}
          class:list={[
            'sidebar-nav-item',
            { [activeClass]: isActive }
          ]}
        >
          {item.icon ? (
            <img 
              src={item.icon} 
              alt={item.text}
              class="sidebar-nav-icon"
            />
          ) : (
            <div class="sidebar-nav-icon bg-gradient-to-br from-purple-400 to-purple-600 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
          )}
          <span class="font-sans text-lg font-medium tracking-wide">
            {item.text}
          </span>
        </a>
      );
    })}
  </nav>
  
  <!-- Spacer -->
  <div class="flex-grow"></div>
  
  <!-- Footer -->
  <div class="text-center text-herbrain-muted text-sm">
    <p>© 2024 Geometric Intelligence</p>
  </div>
</aside>
